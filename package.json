{
  "name": "dbic-handbook",
  "version": "0.0.0",
  "private": true,
  "description": "Markdown style checks for the DBIC Handbook",
  "license": "CC-BY-4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dbic/handbook.git"
